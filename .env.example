# Modelo de configuracao para envio de e-mail em execucao LOCAL.
#
# Copie para .env, preencha e NUNCA commite o .env — ele esta no .gitignore.
# No GitHub Actions, estes valores devem ser cadastrados como GitHub Secrets
# (Settings > Secrets and variables > Actions), nao como arquivo.

SMTP_SERVIDOR=smtp.exemplo.com
SMTP_PORTA=587
SMTP_USUARIO=usuario@exemplo.com
SMTP_SENHA=coloque-aqui-uma-senha-de-aplicativo
EMAIL_REMETENTE=usuario@exemplo.com
EMAIL_DESTINATARIO=destinatario@exemplo.com

# REMETENTE: use uma conta com SMTP direto (Gmail com senha de aplicativo, ou um
# servico transacional como Brevo, Resend ou Mailgun). Proton Mail nao serve como
# remetente aqui: conta pessoal so acessa SMTP pelo Proton Mail Bridge, que e
# aplicativo de desktop, e o token de SMTP exige plano Business com dominio
# proprio. Como DESTINATARIO, qualquer endereco funciona, Proton incluido.

# Data de referencia fixa, para execucoes reproduziveis (opcional).
# DATA_REFERENCIA=2026-09-22
